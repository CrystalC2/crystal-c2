<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Client.Payloads"
        x:Class="Client.Payloads.AddPayloadView"
        x:DataType="vm:AddPayloadViewModel"
        Title="Add Payload"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#161B22"
        Icon="/Assets/logo.png">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="LetterSpacing" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style Selector="TextBox.field">
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="TextBox.field:focus">
            <Setter Property="BorderBrush" Value="#7C3AED"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#30363D"/>
        </Style>
        <Style Selector="Button.browse">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">

        <TextBlock Grid.Row="0" Text="Add Payload" FontSize="17" FontWeight="SemiBold"
                   Foreground="#E6EDF3" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Spacing="16">

            <!-- Name -->
            <StackPanel>
                <TextBlock Text="Name" Classes="label"/>
                <TextBox Classes="field" Text="{Binding Name}" Watermark="e.g. beacon-http"/>
            </StackPanel>

            <!-- File -->
            <StackPanel>
                <TextBlock Text="File" Classes="label"/>
                <Grid ColumnDefinitions="*,8,Auto">
                    <TextBox Grid.Column="0" Classes="field" Text="{Binding FilePath}"
                             IsReadOnly="True" Watermark="No file selected"
                             Foreground="#6E7681"/>
                    <Button Grid.Column="2" Classes="browse" Content="Browse"
                            Click="OnBrowseClicked"/>
                </Grid>
            </StackPanel>

            <!-- YARA (optional) -->
            <StackPanel>
                <TextBlock Text="YARA Rule (optional)" Classes="label"/>
                <Grid ColumnDefinitions="*,8,Auto">
                    <TextBox Grid.Column="0" Classes="field" Text="{Binding YaraPath}"
                             IsReadOnly="True" Watermark="No file selected"
                             Foreground="#6E7681"/>
                    <Button Grid.Column="2" Classes="browse" Content="Browse"
                            Click="OnBrowseYaraClicked"/>
                </Grid>
            </StackPanel>

            <!-- Note (optional) -->
            <StackPanel>
                <TextBlock Text="Note (optional)" Classes="label"/>
                <TextBox Classes="field" Text="{Binding Note}" Watermark="e.g. x64 stageless"/>
            </StackPanel>

        </StackPanel>

        <!-- Footer buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,8,Auto" Margin="0,20,0,0">
            <Button Grid.Column="0" Classes="secondary" Content="Cancel" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Click="OnCancelClicked"/>
            <Button Grid.Column="2" Classes="primary" Content="Add" MinWidth="100"
                    HorizontalContentAlignment="Center" Click="OnAddClicked"
                    IsEnabled="{Binding IsValid}"/>
        </Grid>

    </Grid>
</Window>