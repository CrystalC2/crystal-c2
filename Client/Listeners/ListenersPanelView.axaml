<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Client.Listeners"
             x:Class="Client.Listeners.ListenersPanelView"
             x:DataType="vm:ListenersPanelViewModel"
             Background="#0D1117">

    <UserControl.Styles>
        <Style Selector="Button.icon-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6E7681"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="TextElement.Foreground" Value="#EF4444"/>
        </Style>
        <Style Selector="Button.panel-toggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.panel-toggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.listener-row">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.listener-row:pointerover">
            <Setter Property="Background" Value="#161B22"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Panel header -->
        <Border Grid.Row="0" Background="#161B22"
                BorderBrush="#30363D" BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0" Classes="panel-toggle"
                        Click="OnToggleExpandedClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="▾" FontSize="9" Foreground="#6E7681"
                                   IsVisible="{Binding IsExpanded}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="▸" FontSize="9" Foreground="#6E7681"
                                   IsVisible="{Binding !IsExpanded}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="LISTENERS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#8B949E" LetterSpacing="1"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="icon-btn"
                        Content="+" FontSize="16" FontWeight="Bold"
                        Foreground="#7C3AED"
                        Click="OnCreateListenerClicked"
                        ToolTip.Tip="Create new listener"/>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" IsVisible="{Binding IsExpanded}">

            <!-- Listener list -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding !HasNoListeners}">
                <ItemsControl ItemsSource="{Binding Listeners}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ListenerItemViewModel">
                            <Border Classes="listener-row">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                                    <!-- Running indicator -->
                                    <Ellipse Grid.Column="0" Width="7" Height="7"
                                             Fill="#22C55E" Margin="0,0,10,0"
                                             VerticalAlignment="Center"/>

                                    <!-- Name + port -->
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                   Foreground="#E6EDF3" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding PortDisplay}" FontSize="11"
                                                   Foreground="#6E7681" FontFamily="Consolas"/>
                                    </StackPanel>

                                    <!-- Delete button -->
                                    <Button Grid.Column="2" Classes="icon-btn"
                                            Content="✕" ToolTip.Tip="Delete listener"
                                            Click="OnDeleteListenerClicked"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel IsVisible="{Binding HasNoListeners}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="4" Opacity="0.35">
                <TextBlock Text="No listeners" FontSize="13"
                           Foreground="#8B949E" HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>

    </Grid>
</UserControl>