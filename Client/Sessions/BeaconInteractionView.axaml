<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Client.Sessions"
             x:Class="Client.Sessions.BeaconInteractionView"
             x:DataType="vm:BeaconInteractionViewModel"
             Background="#0D1117">

    <UserControl.Styles>
        <Style Selector="TextBlock.cmd-prefix">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#7C3AED"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.cmd-text">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.cmd-status">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>
        <Style Selector="TextBlock.output, SelectableTextBlock.output">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="16,4,0,0"/>
        </Style>
        <Style Selector="TextBox.input">
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="CaretBrush" Value="#7C3AED"/>
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="TextBox.input:focus">
            <Setter Property="BorderBrush" Value="#7C3AED"/>
        </Style>
        <Style Selector="TextBox.search">
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="CaretBrush" Value="#7C3AED"/>
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style Selector="TextBox.search:focus">
            <Setter Property="BorderBrush" Value="#7C3AED"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Background="#161B22"
                BorderBrush="#30363D" BorderThickness="0,0,0,1"
                Padding="14,9">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <Ellipse Width="8" Height="8"
                             Fill="{Binding Session.HealthBrush}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Title}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#E6EDF3" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBox Grid.Column="1"
                         Classes="search"
                         Text="{Binding Search}"
                         Watermark="Search output..."
                         Margin="16,0"
                         VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Button Content="Railgun"
                            FontSize="12" Padding="10,5"
                            Background="#21262D" Foreground="#7C3AED"
                            BorderBrush="#30363D" BorderThickness="1"
                            CornerRadius="6" Cursor="Hand"
                            Click="OnScriptEditorClicked"/>
                    <Button Content="Remove Session"
                            FontSize="12" Padding="10,5"
                            Background="#21262D" Foreground="#EF4444"
                            BorderBrush="#30363D" BorderThickness="1"
                            CornerRadius="6" Cursor="Hand"
                            Click="OnRemoveSessionClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Output -->
        <ScrollViewer Grid.Row="1" x:Name="OutputScroll"
                      VerticalScrollBarVisibility="Auto"
                      Padding="14,10">
            <ItemsControl ItemsSource="{Binding FilteredEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TaskEntryViewModel">
                        <StackPanel Margin="0,6,0,6">

                            <!-- Command + status -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="&gt; " Classes="cmd-prefix"/>
                                <TextBlock Grid.Column="1" Classes="cmd-text"
                                           vm:HighlightBehavior.Text="{Binding Command}"
                                           vm:HighlightBehavior.SearchTerm="{Binding HighlightTerm}"/>
                                <TextBlock Grid.Column="2" Text="{Binding StatusDisplay}"
                                           Classes="cmd-status"
                                           Foreground="{Binding StatusBrush}"/>
                            </Grid>

                            <!-- Output (only when present) -->
                            <SelectableTextBlock Classes="output"
                                       vm:HighlightBehavior.Text="{Binding Output}"
                                       vm:HighlightBehavior.SearchTerm="{Binding HighlightTerm}"
                                       IsVisible="{Binding Output, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input bar -->
        <Border Grid.Row="2" Background="#161B22"
                BorderBrush="#30363D" BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid ColumnDefinitions="*,8,Auto">
                <Panel Grid.Column="0">
                    <TextBox x:Name="InputBox"
                             Classes="input"
                             Text="{Binding Input}"
                             Watermark="{Binding Watermark}"
                             KeyDown="OnInputKeyDown"/>
                    <TextBlock Text="{Binding Suggestion}"
                               IsVisible="{Binding Suggestion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               FontFamily="Cascadia Mono,Consolas,monospace"
                               FontSize="13"
                               Foreground="#484F58"
                               IsHitTestVisible="False"/>
                </Panel>
                <Button Grid.Column="2" Classes="primary"
                        Content="Run" MinWidth="70"
                        HorizontalContentAlignment="Center"
                        Command="{Binding SubmitCommand}"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>
