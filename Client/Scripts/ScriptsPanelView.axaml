<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Client.Scripts"
             x:Class="Client.Scripts.ScriptsPanelView"
             x:DataType="vm:ScriptsPanelViewModel"
             Background="#0D1117">

    <UserControl.Styles>
        <Style Selector="Button.panel-toggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.panel-toggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.icon-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6E7681"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="TextElement.Foreground" Value="#E6EDF3"/>
        </Style>
        <Style Selector="Button.icon-btn-danger">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6E7681"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.icon-btn-danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="TextElement.Foreground" Value="#EF4444"/>
        </Style>
        <Style Selector="Border.script-row">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style Selector="Border.script-row:pointerover">
            <Setter Property="Background" Value="#161B22"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Panel header -->
        <Border Grid.Row="0" Background="#161B22"
                BorderBrush="#30363D" BorderThickness="0,1,0,1"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0" Classes="panel-toggle"
                        Click="OnToggleExpandedClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="▾" FontSize="9" Foreground="#6E7681"
                                   IsVisible="{Binding IsExpanded}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="▸" FontSize="9" Foreground="#6E7681"
                                   IsVisible="{Binding !IsExpanded}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="SCRIPTS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#8B949E" LetterSpacing="1"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="icon-btn"
                        Content="+" FontSize="16" FontWeight="Bold"
                        Foreground="#7C3AED"
                        Click="OnLoadScriptClicked"
                        ToolTip.Tip="Load script"/>
            </Grid>
        </Border>

        <!-- Script list -->
        <Grid Grid.Row="1" IsVisible="{Binding IsExpanded}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding !HasNoScripts}">
                <ItemsControl ItemsSource="{Binding Scripts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScriptItemViewModel">
                            <Border Classes="script-row">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">

                                    <!-- Name + running indicator -->
                                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                   Foreground="#E6EDF3" FontWeight="Medium"/>
                                        <TextBlock Text="running…" FontSize="10"
                                                   Foreground="#7C3AED"
                                                   IsVisible="{Binding IsRunning}"/>
                                    </StackPanel>

                                    <!-- Run / open console -->
                                    <Button Grid.Column="1" Classes="icon-btn"
                                            Content="▶" FontSize="11"
                                            Foreground="#7C3AED"
                                            Click="OnRunScriptClicked"
                                            ToolTip.Tip="Run script"/>

                                    <!-- Reload from disk -->
                                    <Button Grid.Column="2" Classes="icon-btn"
                                            Content="↺" FontSize="13"
                                            Command="{Binding ReloadCommand}"
                                            ToolTip.Tip="Reload script from disk"/>

                                    <!-- Open output window -->
                                    <Button Grid.Column="3" Classes="icon-btn"
                                            Content="≡" FontSize="13"
                                            Click="OnOpenConsoleClicked"
                                            ToolTip.Tip="Open output window"/>

                                    <!-- Unload -->
                                    <Button Grid.Column="4" Classes="icon-btn-danger"
                                            Content="✕"
                                            Command="{Binding UnloadCommand}"
                                            ToolTip.Tip="Unload script"/>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel IsVisible="{Binding HasNoScripts}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="4" Opacity="0.35">
                <TextBlock Text="No scripts loaded" FontSize="12"
                           Foreground="#8B949E" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>